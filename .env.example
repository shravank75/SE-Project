# Copy to .env.local and fill in. Never commit .env.local.
# Appwrite (client-exposed vars must start with NEXT_PUBLIC_)
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://nyc.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
NEXT_PUBLIC_APPWRITE_BUCKET_ID=
NEXT_PUBLIC_DB_ID=
NEXT_PUBLIC_COLLECTION_ID=

# App URLs
NEXT_PUBLIC_SHORT_URL=http://localhost:3000/f/
NEXT_PUBLIC_DOMAIN=http://localhost:3000

# Server-only (no NEXT_PUBLIC_ prefix)
RESEND_API_KEY=

# Clerk (see https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
